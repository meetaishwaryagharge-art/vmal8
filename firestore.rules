rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['vmalhomecareproducts@gmail.com'];
    }

    // Website reads products and page text; only the admin can change them.
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content/{id}  { allow read: if true; allow write: if isAdmin(); }

    // Visitors can only CREATE an enquiry. Only the admin can read/update/delete.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','email','type','message','status','createdAt'])
                    && request.resource.data.name is string    && request.resource.data.name.size() > 1    && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string   && request.resource.data.phone.size() < 40
                    && request.resource.data.email is string   && request.resource.data.email.size() < 160
                    && request.resource.data.type is string    && request.resource.data.type.size() < 160
                    && request.resource.data.message is string && request.resource.data.message.size() < 3000
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Orders placed from the cart / Buy Now popup. Same idea: create only.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','email','address','pincode','items','total','status','createdAt'])
                    && request.resource.data.name is string    && request.resource.data.name.size() > 1 && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string   && request.resource.data.phone.size() < 40
                    && request.resource.data.email is string   && request.resource.data.email.size() < 160
                    && request.resource.data.address is string && request.resource.data.address.size() < 600
                    && request.resource.data.pincode is string && request.resource.data.pincode.size() < 12
                    && request.resource.data.items is list     && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
  }
}
